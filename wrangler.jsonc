/**
 * Cloudflare Workers config for the Next.js app, served via OpenNext.
 * Dashboard: https://dash.cloudflare.com/?to=/:account/workers/services/view/zec-cyph-tracker/production
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zec-cyph-tracker",
  "main": "custom-worker.ts",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // KV namespace for caching slow-moving upstream data (ZEC circulating
  // supply from CoinGecko / CoinPaprika). 24h TTL — supply ticks once per
  // day, so even per-region CF edge cache (6h) is overkill; KV gets us
  // shared-across-regions caching with explicit eviction control.
  "kv_namespaces": [
    {
      "binding": "SUPPLY_CACHE",
      "id": "0e6e4fd99d204c75a14eba9e552bc9be"
    },
    {
      // OpenNext's incremental cache (prerendered pages, ISR, RSC payloads).
      // Same namespace as SUPPLY_CACHE on purpose: OpenNext prefixes every
      // key with `incremental-cache/<build id>`, so the two never collide,
      // and a second namespace would need dashboard access to create.
      "binding": "NEXT_INC_CACHE_KV",
      "id": "0e6e4fd99d204c75a14eba9e552bc9be"
    }
  ],
  // Atomic lock for the cron jobs. One object per job name, so acquisition and
  // release are indivisible — which is the thing KV could not do, and why the
  // lock moved here. SQLite-backed because that is the current default for new
  // classes; the object stores a single record and never grows.
  "durable_objects": {
    "bindings": [
      {
        "name": "SCHEDULER_LOCK",
        "class_name": "SchedulerLock"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SchedulerLock"]
    }
  ],
  // OpenNext's ISR revalidation (the memory queue in open-next.config.ts)
  // re-requests a stale page through this binding rather than over the public
  // internet. The service name must be this Worker's own name.
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "zec-cyph-tracker"
    }
  ],
  "observability": {
    "enabled": true
  },
  "triggers": {
    // Ten ticks an hour, not sixty: the per-minute cron was ~86% of the
    // account's Workers CPU. The minute list is not arbitrary. JOBS in
    // lib/jobs/scheduled.ts picks a pool from the UTC minute, so a plain
    // "*/10" would only ever run ironwood. :00/:10/:20/:30/:40/:50 run
    // ironwood, :02/:32 orchard, :07/:37 sapling. Change both together.
    "crons": ["0,2,7,10,20,30,32,37,40,50 * * * *"]
  },
  "routes": [
    {
      "pattern": "cyphzec.com",
      "custom_domain": true
    },
    {
      "pattern": "cyphzec.jiggytom.com",
      "custom_domain": true
    },
    {
      // Beta subdomain — kept bound as a parallel mirror after the
      // beta→main promotion. The Worker serves the same routes
      // regardless of host (no middleware rewrite), so anyone hitting
      // beta.cyphzec.com sees the same site as cyphzec.com. Existing
      // bookmarks to the preview domain keep working.
      "pattern": "beta.cyphzec.com",
      "custom_domain": true
    }
  ]
}
