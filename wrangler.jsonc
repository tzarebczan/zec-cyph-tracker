/**
 * Cloudflare Workers config for the Next.js app, served via OpenNext.
 * Dashboard: https://dash.cloudflare.com/?to=/:account/workers/services/view/zec-cyph-tracker/production
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zec-cyph-tracker",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // KV namespace for caching slow-moving upstream data (ZEC circulating
  // supply from CoinGecko / CoinPaprika). 24h TTL — supply ticks once per
  // day, so even per-region CF edge cache (6h) is overkill; KV gets us
  // shared-across-regions caching with explicit eviction control.
  "kv_namespaces": [
    {
      "binding": "SUPPLY_CACHE",
      "id": "0e6e4fd99d204c75a14eba9e552bc9be"
    }
  ],
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "cyphzec.com",
      "custom_domain": true
    },
    {
      "pattern": "cyphzec.jiggytom.com",
      "custom_domain": true
    },
    {
      // Beta subdomain — middleware.ts rewrites requests on this host
      // onto the /beta/* route tree so the redesign is the entire
      // site here (clean URLs, no /beta prefix). When the redesign
      // is ready for the main site, point cyphzec.com itself at the
      // beta routes from middleware and this entry can stay or be
      // removed depending on whether we want a parallel preview.
      "pattern": "beta.cyphzec.com",
      "custom_domain": true
    }
  ]
}
